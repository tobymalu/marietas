---
import AboutSections from "../../components/about/AboutSections.astro";
import Layout from "../../layouts/Layout.astro";
import { getAboutContent } from "../../lib/about-content";
import { aboutPageSchema } from "../../lib/schema";

const { meta } = getAboutContent("es");
---

<Layout
  title={meta.title}
  description={meta.description}
  alternateUrl="/en/about/"
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(aboutPageSchema(meta))}
  />
  <AboutSections lang="es" />
</Layout>
