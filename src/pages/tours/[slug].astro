---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const tours = await getCollection('tours');
  return tours.map((tour) => ({ params: { slug: tour.id }, props: { tour } }));
}

const { tour } = Astro.props;
const { Content } = await render(tour);
const standardPrices = tour.data.precios.filter((price) => price.tipo === 'estandar');
const lowestPrice = Math.min(...standardPrices.map((price) => price.precio));
const currency = standardPrices[0]?.moneda ?? 'MXN';
const updatedDate = tour.data.ultima_actualizacion?.toLocaleDateString('es-MX', { timeZone: 'UTC', dateStyle: 'long' });
const currentMonth = new Date().getUTCMonth() + 1;
const operatesThisMonth = tour.data.meses.length === 0 || tour.data.meses.includes(currentMonth);
---

<Layout title={tour.data.seo.meta_title} description={tour.data.seo.meta_description} canonical={tour.data.seo.canonical} ogImage={tour.data.seo.og_image} noindex={tour.data.seo.noindex} type="article">
  <article class="container tour-detail">
    <div class="tour-detail__intro">
      <p class="eyebrow">{tour.data.duracion} · Islas Marietas</p>
      <h1>{tour.data.h1}</h1>
      <p class="tour-detail__summary">{tour.data.resumen}</p>
    </div>
    <div class="tour-detail__gallery">
      {tour.data.galeria.map((image) => <img src={image.imagen} alt={image.alt} width="900" height="600" />)}
    </div>
    <div class="tour-detail__columns">
      <div class="prose"><Content />{updatedDate && <p class="updated">Última actualización: {updatedDate}</p>}</div>
      <aside class="price-panel">
        <p class="eyebrow">Reserva tu lugar</p>
        <p class="from-label">Desde</p>
        <p class="price">{currency} ${lowestPrice.toLocaleString('es-MX')} <small>por persona</small></p>
        <p class="price-note">{tour.data.nota_precio}</p>
        <a class="button" href="https://wa.me/523221473221" data-whatsapp-cta>{operatesThisMonth ? 'Consultar disponibilidad' : 'Unirme a la lista de espera'} <span aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </article>
</Layout>

<style>
  .tour-detail { padding-block:clamp(4rem,9vw,8rem); }
  .tour-detail__intro { max-width:760px; }
  .eyebrow { color:var(--color-accent); text-transform:uppercase; letter-spacing:.14em; font-size:.72rem; font-weight:700; }
  h1 { margin:.7rem 0 1.2rem; font:600 clamp(3rem,8vw,6.3rem)/.94 var(--font-display); letter-spacing:-.03em; }
  .tour-detail__summary { color:var(--color-muted); font-size:1.2rem; line-height:1.7; }
  .tour-detail__gallery { display:grid; grid-template-columns:1.4fr 1fr; gap:1rem; margin-block:3rem 4rem; }
  .tour-detail__gallery img { display:block; width:100%; height:100%; min-height:280px; object-fit:cover; }
  .tour-detail__columns { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(260px,.6fr); gap:clamp(2rem,8vw,7rem); align-items:start; }
  .prose { color:var(--color-foreground); line-height:1.8; }
  .prose :global(h2) { font:600 2rem/1.1 var(--font-display); }
  .updated { margin-top:2.5rem; color:var(--color-muted); font-size:.8rem; }
  .price-panel { position:sticky; top:110px; padding:1.5rem; background:white; border-top:4px solid var(--color-accent); box-shadow:0 18px 40px #173b4012; }
  .from-label { margin:1.5rem 0 0; color:var(--color-muted); font-size:.8rem; }
  .price { margin:.2rem 0 1rem; color:var(--color-primary); font:600 2rem/1 var(--font-display); }
  .price small { display:block; margin-top:.4rem; color:var(--color-muted); font:400 .75rem var(--font-body); }
  .price-note { padding:1rem; color:var(--color-foreground); background:#f7f1e8; font-size:.85rem; line-height:1.5; }
  .button { display:inline-flex; justify-content:center; gap:.5rem; width:100%; box-sizing:border-box; padding:.85rem 1rem; color:white; background:var(--color-primary); font-weight:700; }
  @media(max-width:720px) { .tour-detail__gallery, .tour-detail__columns { grid-template-columns:1fr; } .price-panel { position:static; } }
</style>