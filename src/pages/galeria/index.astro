---
import Photo from "../../components/Photo.astro";
import Layout from "../../layouts/Layout.astro";
const images = [
  ["/imgMarietas/Marietas.jpg", "Formaciones rocosas de las Islas Marietas"],
  ["/imgMarietas/Snorkeling.jpg", "Snorkel en las aguas claras del santuario"],
  [
    "/imgMarietas/AvesMarietas/bobo pata azules.jpg",
    "Ave marina sobre una roca de las islas",
  ],
  [
    "/imgMarietas/VistaPlayaEscondida.jpg",
    "Vista de Playa Escondida desde el mar",
  ],
];
---

<Layout
  title="Galería | Islas Marietas"
  description="Una mirada a los paisajes, la vida marina y las experiencias de Islas Marietas."
  alternateUrl="/en/gallery/"
>
  <section class="container gallery-page">
    <p class="eyebrow">Postales del santuario</p><h1>
      El paisaje cambia con cada marea.
    </h1><div class="gallery-grid">
      {
        images.map(([src, alt], index) => (
          <Photo
            src={src}
            alt={alt}
            sizes="(max-width: 720px) 100vw, 560px"
            widths={[480, 800, 1120]}
            priority={index === 0}
          />
        ))
      }
    </div>
  </section>
</Layout>

<style is:global>
  .gallery-page {
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .eyebrow {
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
    font-weight: 700;
  }
  .gallery-page h1 {
    max-width: 11ch;
    margin: 0.6rem 0 3rem;
    font: 600 clamp(3rem, 8vw, 6rem)/0.95 var(--font-display);
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .gallery-grid img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
  }
  .gallery-grid picture:nth-child(2) img,
  .gallery-grid picture:nth-child(3) img {
    aspect-ratio: 3/4;
  }
  @media (max-width: 600px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
    .gallery-grid img,
    .gallery-grid picture:nth-child(2) img,
    .gallery-grid picture:nth-child(3) img {
      aspect-ratio: 4/3;
    }
  }
</style>
