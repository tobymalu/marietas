---
import AboutSections from "../../../components/about/AboutSections.astro";
import Layout from "../../../layouts/Layout.astro";
import { getAboutContent } from "../../../lib/about-content";
import { aboutPageSchema } from "../../../lib/schema";

const { meta } = getAboutContent("en");
---

<Layout
  lang="en"
  title={meta.title}
  description={meta.description}
  alternateUrl="/nosotros/"
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(aboutPageSchema(meta))}
  />
  <AboutSections lang="en" />
</Layout>
