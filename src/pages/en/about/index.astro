---
import Layout from '../../../layouts/Layout.astro';
---

<Layout lang="en" title="About us | Islas Marietas" description="Meet the local crew behind your Islas Marietas experience." alternateUrl="/nosotros/">
  <section class="container editorial-page"><p class="eyebrow">Our way of navigating</p><h1>Getting to know a place also means learning how to care for it.</h1><img src="/imgMarietas/nosotros.jpg" alt="Local crew preparing an Islas Marietas experience" width="1200" height="700" /><div class="copy"><p>We are a local crew who knows these waters, their seasons and the responsibility that comes with welcoming visitors to a natural sanctuary.</p><p>We create honest, clear and personal trips so every visit feels like an invitation, not a conquest.</p></div></section>
</Layout>

<style is:global>
  .editorial-page { padding-block:clamp(4rem,9vw,8rem); }.eyebrow { color:var(--color-accent); text-transform:uppercase; letter-spacing:.14em; font-size:.72rem; font-weight:700; }.editorial-page h1 { max-width:12ch; margin:.6rem 0 2.5rem; font:600 clamp(3rem,8vw,6rem)/.95 var(--font-display); }.editorial-page>img { width:100%; max-height:560px; object-fit:cover; }.copy { display:grid; grid-template-columns:1fr 1fr; gap:3rem; max-width:780px; margin:3rem 0 0 auto; color:var(--color-muted); line-height:1.8; }@media(max-width:720px) { .copy { grid-template-columns:1fr; gap:0; } }
</style>