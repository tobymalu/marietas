---
import Layout from "../../../layouts/Layout.astro";
const images = [
  [
    "/imgMarietas/Marietas.jpg",
    "Volcanic rock formations in the Islas Marietas",
  ],
  [
    "/imgMarietas/Snorkeling.jpg",
    "Snorkeling in the clear waters of the sanctuary",
  ],
  [
    "/imgMarietas/AvesMarietas/bobo pata azules.jpg",
    "Seabird resting on a rock in the islands",
  ],
  ["/imgMarietas/VistaPlayaEscondida.jpg", "Hidden Beach seen from the water"],
];
---

<Layout
  lang="en"
  title="Gallery | Islas Marietas"
  description="A glimpse of the landscapes, wildlife and ocean experiences at Islas Marietas."
  alternateUrl="/galeria/"
>
  <section class="container gallery-page">
    <p class="eyebrow">Postcards from the sanctuary</p><h1>
      The view changes with every tide.
    </h1><div class="gallery-grid">
      {
        images.map(([src, alt]) => (
          <img src={src} alt={alt} width="800" height="600" loading="lazy" />
        ))
      }
    </div>
  </section>
</Layout>

<style is:global>
  .gallery-page {
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .eyebrow {
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
    font-weight: 700;
  }
  .gallery-page h1 {
    max-width: 11ch;
    margin: 0.6rem 0 3rem;
    font: 600 clamp(3rem, 8vw, 6rem)/0.95 var(--font-display);
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .gallery-grid img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
  }
  .gallery-grid img:nth-child(2),
  .gallery-grid img:nth-child(3) {
    aspect-ratio: 3/4;
  }
  @media (max-width: 600px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
    .gallery-grid img,
    .gallery-grid img:nth-child(2),
    .gallery-grid img:nth-child(3) {
      aspect-ratio: 4/3;
    }
  }
</style>
