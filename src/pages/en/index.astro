---
import HomeSections from "../../components/home/HomeSections.astro";
import Layout from "../../layouts/Layout.astro";
import { buildFaq, getParkInfo } from "../../lib/home-content";
import { faqSchema, travelAgencySchema } from "../../lib/schema";

const agencySchema = await travelAgencySchema();
const faq = buildFaq("en");
---

<Layout
  lang="en"
  title="Islas Marietas & Hidden Beach Tours | 2026 Prices"
  description="Book your Islas Marietas tour to Hidden Beach from Puerto Vallarta. Clear prices, small groups and local guides."
  alternateUrl="/"
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(agencySchema)}
  />
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema([...faq, ...getParkInfo("en")]))}
  />
  <HomeSections lang="en" faq={faq} />
</Layout>
