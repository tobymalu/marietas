---
import Layout from '../../layouts/Layout.astro';
import { site, whatsappUrl } from '../../lib/site';
---

<Layout title="Contacto | Islas Marietas" description="Habla con nuestro equipo para planear tu visita a las Islas Marietas." alternateUrl="/en/contact/">
  <section class="container contact-page"><div><p class="eyebrow">Hablemos del mar</p><h1>Tu próxima historia empieza con un mensaje.</h1><p>Cuéntanos qué experiencia estás buscando y te ayudamos a elegir la mejor fecha y ruta.</p></div><div class="contact-links"><a href={whatsappUrl()}><span>WhatsApp</span><strong>Escríbenos directamente ↗</strong></a><a href={`tel:${site.phone.e164}`}><span>Teléfono</span><strong>{site.phone.display}</strong></a><a href={`mailto:${site.email}`}><span>Correo</span><strong>{site.email}</strong></a></div></section>
</Layout>

<style is:global>
  .contact-page { display:grid; grid-template-columns:1fr 1fr; gap:clamp(3rem,10vw,9rem); padding-block:clamp(5rem,12vw,10rem); align-items:center; } .eyebrow { color:var(--color-accent); text-transform:uppercase; letter-spacing:.14em; font-size:.72rem; font-weight:700; } .contact-page h1 { max-width:10ch; margin:.6rem 0 1.2rem; font:600 clamp(3rem,7vw,5.8rem)/.95 var(--font-display); } .contact-page > div:first-child > p:last-child { max-width:38ch; color:var(--color-muted); line-height:1.7; } .contact-links { display:grid; border-top:1px solid #cbd9d2; } .contact-links a { display:grid; gap:.35rem; padding:1.2rem 0; border-bottom:1px solid #cbd9d2; } .contact-links span { color:var(--color-accent); font-size:.72rem; text-transform:uppercase; letter-spacing:.12em; font-weight:700; } .contact-links strong { color:var(--color-primary); font-size:1.05rem; } @media(max-width:720px) { .contact-page { grid-template-columns:1fr; } }
</style>