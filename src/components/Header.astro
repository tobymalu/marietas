---
import { NAV_LINKS, site } from '../lib/site';
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label={`${site.name}, inicio`}>
      <img src="/imgMarietas/MarietasLogo.png" alt="" width="48" height="48" />
      <span>{site.name}</span>
    </a>
    <nav aria-label="Navegación principal">
      <details class="mobile-menu">
        <summary aria-label="Abrir menú">Menú</summary>
        <div class="mobile-menu__panel">
          {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </details>
      <div class="desktop-menu">
        {NAV_LINKS.map((link) => <a class:list-active={currentPath === link.href} href={link.href}>{link.label}</a>)}
      </div>
    </nav>
  </div>
</header>