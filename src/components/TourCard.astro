---
import type { CollectionEntry } from "astro:content";
import { whatsappUrl, type SiteLanguage } from "../lib/site";
import { lowestStandardPrice } from "../lib/tours";

interface Props {
  tour: CollectionEntry<"tours"> | CollectionEntry<"toursEn">;
  lang?: SiteLanguage;
}

const { tour, lang = "es" } = Astro.props;
const data = tour.data;
const price = lowestStandardPrice(data.precios);
const href = lang === "en" ? `/en/tours/${tour.id}/` : `/tours/${tour.id}/`;
const locale = lang === "en" ? "en-US" : "es-MX";
const copy =
  lang === "en"
    ? { from: "From", quote: "Price on request", details: "View details", book: "Book", ask: "Get a quote" }
    : { from: "Desde", quote: "Precio a cotizar", details: "Ver detalles", book: "Reservar", ask: "Cotizar" };
---

<article class="tour-card">
  <a class="tour-card__media" href={href} tabindex="-1" aria-hidden="true">
    <img
      src={data.galeria[0].imagen}
      alt=""
      width="1200"
      height="800"
      loading="lazy"
      decoding="async"
    />
    {
      data.badges.length > 0 && (
        <ul class="tour-card__badges">
          {data.badges.map((badge) => (
            <li>{badge}</li>
          ))}
        </ul>
      )
    }
  </a>
  <div class="tour-card__body">
    <h3>
      <a href={href}>{data.nombre}</a>
    </h3>
    <p>{data.resumen}</p>
    <div class="tour-card__price">
      {
        price ? (
          <>
            <span>{copy.from}</span>
            <strong>
              ${price.amount.toLocaleString(locale)} {price.currency}
            </strong>
          </>
        ) : (
          <strong>{copy.quote}</strong>
        )
      }
      <span>· {data.duracion}</span>
    </div>
    <p class="tour-card__note">
      <span aria-hidden="true">ⓘ</span>
      {data.nota_precio}
    </p>
    <div class="tour-card__actions">
      <a class="tour-card__button" href={href}>
        {copy.details} <span aria-hidden="true">→</span>
      </a>
      <a class="tour-card__link" href={whatsappUrl()} target="_blank" rel="noreferrer">
        {price ? copy.book : copy.ask} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</article>

<style>
  .tour-card {
    display: flex;
    flex-direction: column;
    background: white;
    border: 1px solid #dce5df;
    transition:
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }
  .tour-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px #173b4018;
  }
  .tour-card__media {
    position: relative;
    display: block;
    overflow: hidden;
  }
  .tour-card__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .tour-card:hover .tour-card__media img {
    transform: scale(1.05);
  }
  .tour-card__badges {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tour-card__badges li {
    padding: 0.3rem 0.55rem;
    background: var(--color-foreground);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .tour-card__badges li:first-child {
    background: var(--color-accent);
  }
  .tour-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.35rem;
  }
  h3 {
    margin: 0;
    font: 600 1.6rem/1.1 var(--font-display);
  }
  h3 a:hover {
    color: var(--color-primary);
  }
  .tour-card__body > p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.6;
  }
  .tour-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid #e6ece9;
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  .tour-card__price strong {
    color: var(--color-foreground);
    font-size: 1.35rem;
  }
  .tour-card__body > .tour-card__note {
    padding: 0.6rem 0.75rem;
    background: #fbf3ea;
    color: #7a4a2f;
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .tour-card__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .tour-card__button {
    display: inline-flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.1rem;
    background: var(--color-primary);
    color: white;
    font-weight: 700;
    transition: filter 0.2s ease;
  }
  .tour-card__button:hover {
    filter: brightness(1.1);
  }
  .tour-card__button span {
    transition: transform 0.2s ease;
  }
  .tour-card__button:hover span {
    transform: translateX(3px);
  }
  .tour-card__button:focus-visible,
  .tour-card__link:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }
  .tour-card__link {
    display: inline-flex;
    gap: 0.4rem;
    color: var(--color-primary);
    font-weight: 700;
  }
  @media (prefers-reduced-motion: reduce) {
    .tour-card,
    .tour-card__media img,
    .tour-card__button span {
      transition: none;
    }
  }
</style>
