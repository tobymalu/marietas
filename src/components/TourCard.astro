---
interface Props {
  tour: {
    id: string;
    data: {
      nombre: string;
      resumen: string;
      precios: { precio: number; moneda: string; tipo: string }[];
      galeria: { imagen: string; alt: string }[];
      duracion: string;
    };
  };
}

const { tour } = Astro.props;
const standardPrices = tour.data.precios.filter((price) => price.tipo === 'estandar');
const lowestPrice = Math.min(...standardPrices.map((price) => price.precio));
const currency = standardPrices[0]?.moneda ?? 'MXN';
---

<article class="tour-card">
  <img src={tour.data.galeria[0].imagen} alt={tour.data.galeria[0].alt} width="720" height="480" loading="lazy" />
  <div class="tour-card__body">
    <p class="tour-card__meta">{tour.data.duracion} · Desde {currency} ${lowestPrice.toLocaleString('es-MX')}</p>
    <h2>{tour.data.nombre}</h2>
    <p>{tour.data.resumen}</p>
    <a class="text-link" href={`/tours/${tour.id}/`}>Conocer el tour <span aria-hidden="true">→</span></a>
  </div>
</article>