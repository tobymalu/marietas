---
// Portada a sangre completa con overlay: texto a la izquierda y una tarjeta
// (formulario, datos…) a la derecha vía <slot />. Usada por home y nosotros.
interface Props {
  image: { src: string; alt: string; width: number; height: number };
  eyebrow: string;
  title: string;
  lede: string;
  trust?: string;
}

const { image, eyebrow, title, lede, trust } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <img
    class="hero__bg"
    src={image.src}
    alt={image.alt}
    width={image.width}
    height={image.height}
    fetchpriority="high"
  />
  <div class="hero__inner container">
    <div class="hero__copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="hero-title">{title}</h1>
      <p class="hero__lede">{lede}</p>
      {
        trust && (
          <p class="hero__trust">
            <span aria-hidden="true">✓</span> {trust}
          </p>
        )
      }
    </div>
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: min(88vh, 820px);
    color: white;
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      #0b262aee 0%,
      #0b262ab0 45%,
      #0b262a40 100%
    );
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }
  .hero .eyebrow {
    color: #ffb08f;
  }
  .hero h1 {
    max-width: 16ch;
    margin: 0.7rem 0 1.2rem;
    font: 600 clamp(2.4rem, 5.4vw, 4.6rem)/1.02 var(--font-display);
    letter-spacing: -0.02em;
  }
  .hero__lede {
    max-width: 46ch;
    color: #dbe9e5;
    font-size: 1.08rem;
    line-height: 1.7;
  }
  .hero__trust {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid #ffffff40;
    background: #ffffff14;
    backdrop-filter: blur(6px);
    font-size: 0.82rem;
    font-weight: 700;
  }
  @media (max-width: 860px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero::after {
      background: linear-gradient(180deg, #0b262ad0 0%, #0b262aee 100%);
    }
  }
</style>
