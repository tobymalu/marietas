---
// Cuerpo de Nosotros / About us, compartido por /nosotros/ y /en/about/.
import { getAboutContent } from "../../lib/about-content";
import { whatsappUrl, type SiteLanguage } from "../../lib/site";
import Gallery from "../Gallery.astro";
import LocationMap from "../LocationMap.astro";
import PageHero from "../PageHero.astro";
import ValueBar from "../ValueBar.astro";

interface Props {
  lang?: SiteLanguage;
}

const { lang = "es" } = Astro.props;
const t = getAboutContent(lang);

const sanctuaryPhotos = [
  {
    src: "/imgMarietas/Nueva carpeta/ec63feb1-9950-4a6e-97bc-fcbd01125099.jpg",
    width: 1280,
    height: 960,
    size: "large" as const,
  },
  { src: "/imgMarietas/AvesMarietas/bobo pata azules.jpg", width: 1500, height: 1000 },
  { src: "/imgMarietas/FaunaMarMarietas/coral hermatípico.jpg", width: 800, height: 1067 },
  {
    src: "/imgMarietas/plantasMarietas/marietas desde la isla.jpg",
    width: 2448,
    height: 2448,
    size: "wide" as const,
  },
].map((photo, index) => ({ ...photo, alt: t.gallery.alts[index] }));
---

<div class="sections">
  <!-- 1. Portada (misma estructura que el home) -->
  <PageHero
    image={{
      src: "/imgMarietas/marietas formacion volcanica.jpg",
      alt: t.hero.alt,
      width: 3648,
      height: 2736,
    }}
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    lede={t.hero.lede}
    trust={t.hero.trust}
  >
    <aside class="facts-card" aria-labelledby="facts-title">
      <p class="facts-card__title" id="facts-title">{t.hero.factsTitle}</p>
      <dl>
        {
          t.hero.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
      <a class="button button--accent" href={t.toursHref}>{t.hero.cta}</a>
    </aside>
  </PageHero>

  <!-- 2. Barra de compromisos (misma barra que el home) -->
  <ValueBar items={t.pillars.items} label={t.pillars.label} />

  <!-- 3. Historia -->
  <section class="container section-space" aria-labelledby="history-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t.history.eyebrow}</p>
        <h2 class="section-title" id="history-title">{t.history.title}</h2>
        <p class="section-lede">{t.history.lede}</p>
      </div>
    </div>
    <ol class="timeline">
      {
        t.history.timeline.map((item) => (
          <li>
            <strong>{item.year}</strong>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 4. Quiénes somos -->
  <section class="team" aria-labelledby="team-title">
    <div class="container team__grid">
      <img
        class="team__photo"
        src="/SegundoCrater.jpg"
        alt={t.team.alt}
        width="1080"
        height="810"
        loading="lazy"
      />
      <div>
        <p class="eyebrow">{t.team.eyebrow}</p>
        <h2 class="section-title" id="team-title">{t.team.title}</h2>
        {t.team.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <!-- 5. Galería del santuario (mismo componente que el home) -->
  <Gallery
    lang={lang}
    eyebrow={t.gallery.eyebrow}
    title={t.gallery.title}
    photos={sanctuaryPhotos}
  />

  <!-- 6. Manifiesto -->
  <section class="manifesto" aria-label={t.manifesto.label}>
    <div class="container">
      <p class="eyebrow">{t.manifesto.label}</p>
      <blockquote>{t.manifesto.quote}</blockquote>
    </div>
  </section>

  <!-- 7. Viajero responsable (mismo formato que las preguntas frecuentes) -->
  <section class="container section-space responsible" aria-labelledby="rules-title">
    <div>
      <p class="eyebrow">{t.rules.eyebrow}</p>
      <h2 class="section-title" id="rules-title">{t.rules.title}</h2>
      <p class="section-lede">{t.rules.lede}</p>
      <a class="text-link" href={whatsappUrl()} target="_blank" rel="noreferrer"
        >{t.rules.cta} <span aria-hidden="true">↗</span></a
      >
    </div>
    <ul class="rules">
      {t.rules.items.map((rule) => <li>{rule}</li>)}
    </ul>
  </section>

  <!-- 8. Ruta ilustrada -->
  <section class="route" aria-labelledby="route-title">
    <div class="container route__grid">
      <img
        src="/imgMarietas/nosotros.jpg"
        alt={t.route.alt}
        width="1600"
        height="1600"
        loading="lazy"
      />
      <div>
        <p class="eyebrow">{t.route.eyebrow}</p>
        <h2 class="section-title" id="route-title">{t.route.title}</h2>
        <p class="section-lede">{t.route.lede}</p>
        <div class="route__actions">
          <a class="button button--primary" href={t.toursHref}>{t.route.tours}</a>
          <a class="text-link" href={whatsappUrl()} target="_blank" rel="noreferrer"
            >{t.route.talk} <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </div>
  </section>

  <LocationMap lang={lang} />
</div>

<style>
  .section-lede {
    max-width: 58ch;
    margin: 0 0 1rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  /* Tarjeta de la portada: mismo estilo que el formulario de reserva */
  .facts-card {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--color-foreground);
    background: var(--color-background);
    box-shadow: 0 24px 60px #0b262a55;
  }
  .facts-card__title {
    margin: 0;
    font: 600 1.5rem/1.1 var(--font-display);
  }
  .facts-card dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    margin: 0;
    background: #d3ddd9;
    border: 1px solid #d3ddd9;
  }
  .facts-card dl div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.3rem;
    padding: 0.9rem;
    background: white;
  }
  .facts-card dt {
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.4;
  }
  .facts-card dd {
    margin: 0;
    color: var(--color-primary);
    font: 600 1.5rem/1 var(--font-display);
  }
  .facts-card .button {
    justify-content: center;
    min-height: 3.2rem;
  }

  /* Línea de tiempo en tarjetas, como las de tours */
  .timeline {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .timeline li {
    padding: 1.35rem;
    background: white;
    border: 1px solid #dce5df;
    border-top: 4px solid var(--color-accent);
  }
  .timeline strong {
    color: var(--color-primary);
    font: 600 1.6rem/1 var(--font-display);
  }
  .timeline p {
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* Equipo: fondo arena como la guía del parque del home */
  .team {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: #ebe4d6;
  }
  .team__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .team__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    box-shadow: 0 24px 60px #173b4025;
  }
  .team__grid p:not(.eyebrow) {
    color: var(--color-muted);
    line-height: 1.7;
  }

  /* Manifiesto: bloque oscuro como las reseñas del home */
  .manifesto {
    padding-block: clamp(4rem, 9vw, 7rem);
    background: var(--color-foreground);
    color: #f4efe5;
    text-align: center;
  }
  .manifesto .eyebrow {
    color: #ffb08f;
  }
  .manifesto blockquote {
    max-width: 30ch;
    margin: 1rem auto 0;
    font: 500 italic clamp(1.8rem, 4vw, 3rem)/1.2 var(--font-display);
  }

  /* Viajero responsable: mismo esquema de 2 columnas que las FAQ */
  .responsible {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .rules {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid #d3ddd9;
  }
  .rules li {
    display: flex;
    gap: 0.9rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid #d3ddd9;
    font-weight: 700;
    line-height: 1.5;
  }
  .rules li::before {
    content: "✓";
    flex-shrink: 0;
    color: var(--color-accent);
    font-size: 1.1rem;
  }

  /* Ruta ilustrada: fondo arena */
  .route {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: #ebe4d6;
  }
  .route__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .route img {
    display: block;
    width: 100%;
    height: auto;
    box-shadow: 0 24px 60px #173b4025;
  }
  .route__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 1000px) {
    .timeline {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
  }
  @media (max-width: 860px) {
    .team__grid,
    .responsible,
    .route__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
