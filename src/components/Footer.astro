---
import { NAV_LINKS, NAV_LINKS_EN, site, type SiteLanguage } from "../lib/site";
interface Props {
  lang?: SiteLanguage;
}
const { lang = "es" } = Astro.props;
const navLinks = lang === "en" ? NAV_LINKS_EN : NAV_LINKS;
const copy =
  lang === "en"
    ? {
        kicker: "Travel with intention",
        title: "The ocean is waiting for you.",
        body: "Thoughtful experiences to discover the Islas Marietas sanctuary.",
        explore: "Explore",
        reserve: "Book your trip",
        rights: "All rights reserved.",
      }
    : {
        kicker: "Navega con intención",
        title: "El mar te está esperando.",
        body: "Experiencias responsables para conocer el santuario de las Islas Marietas.",
        explore: "Explora",
        reserve: "Reserva",
        rights: "Todos los derechos reservados.",
      };
---

<footer class="site-footer">
  <div class="site-footer__grid">
    <div>
      <p class="footer-kicker">{copy.kicker}</p>
      <h2>{copy.title}</h2>
      <p>{copy.body}</p>
    </div>
    <div>
      <p class="footer-kicker">{copy.explore}</p>
      {navLinks.slice(1, 5).map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
    <div>
      <p class="footer-kicker">{copy.reserve}</p>
      <a href={`tel:${site.phone.e164}`}>{site.phone.display}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.social.instagram}>Instagram</a>
    </div>
  </div>
  <div class="site-footer__bottom">
    © {new Date().getFullYear()}
    {site.name}. {copy.rights}
  </div>
</footer>
