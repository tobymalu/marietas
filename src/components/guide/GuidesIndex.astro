---
// Listado de guías para /blog/ y /en/blog/.
import { getGuides } from "../../lib/guides";
import type { SiteLanguage } from "../../lib/site";
import GuideCard from "./GuideCard.astro";

interface Props {
  lang?: SiteLanguage;
}

const { lang = "es" } = Astro.props;
const guides = await getGuides(lang);
const copy =
  lang === "en"
    ? {
        eyebrow: "Islas Marietas guides",
        title: "Plan your visit with local knowledge",
        lede: "Practical guides written by our crew: access, permits, seasons and tips to make the most of the islands.",
      }
    : {
        eyebrow: "Guías de las Islas Marietas",
        title: "Planea tu visita con información local",
        lede: "Guías prácticas escritas por nuestro equipo: accesos, permisos, temporadas y consejos para aprovechar al máximo las islas.",
      };
---

<div class="sections">
  <section class="container guides-intro">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.title}</h1>
    <p>{copy.lede}</p>
  </section>

  <section class="container guides-grid">
    {guides.map((guide) => <GuideCard guide={guide} lang={lang} />)}
  </section>
</div>

<style>
  .guides-intro {
    padding-block: clamp(4rem, 9vw, 7rem) 2.5rem;
  }
  .guides-intro h1 {
    max-width: 18ch;
    margin: 0.7rem 0 1rem;
    font: 600 clamp(2.6rem, 6vw, 4.6rem)/1 var(--font-display);
    letter-spacing: -0.02em;
  }
  .guides-intro > p:last-child {
    max-width: 56ch;
    color: var(--color-muted);
    font-size: 1.1rem;
    line-height: 1.7;
  }
  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }
</style>
