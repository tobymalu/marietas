---
// Llamada a la acción al final de una guía.
// variant "tours" (por defecto): botón a /tours/ + WhatsApp.
// variant "both": un botón a cada tour (para guías comparativas) + WhatsApp.
import { whatsappUrl, type SiteLanguage } from "../../lib/site";

interface Props {
  lang?: SiteLanguage;
  variant?: "tours" | "both";
}

const { lang = "es", variant = "tours" } = Astro.props;
const base = lang === "en" ? "/en/tours/" : "/tours/";
const copy =
  lang === "en"
    ? {
        title: "Ready to visit Hidden Beach?",
        text: "Check availability for your date. We confirm your CONANP time slot and the final price before you pay.",
        tours: "See our tours",
        toursHref: "/en/tours/",
        whatsapp: "Ask on WhatsApp",
        bothTitle: "Which one is your Islas Marietas day?",
        bothText: "Both tours include breakfast, lunch, open bar and water activities. Check availability for your date before you pay.",
        special: "Hidden Beach tour",
        classic: "Classic snorkel tour",
      }
    : {
        title: "¿Listo para conocer la Playa Escondida?",
        text: "Consulta disponibilidad para tu fecha. Te confirmamos el horario CONANP y el precio final antes de pagar.",
        tours: "Ver nuestros tours",
        toursHref: "/tours/",
        whatsapp: "Preguntar por WhatsApp",
        bothTitle: "¿Cuál es tu día en las Islas Marietas?",
        bothText: "Los dos tours incluyen desayuno, comida, barra libre y actividades acuáticas. Consulta disponibilidad para tu fecha antes de pagar.",
        special: "Tour Playa Escondida",
        classic: "Tour tradicional de snorkel",
      };
const both = variant === "both";
---

<aside class="guide-cta not-prose">
  <div>
    <p class="guide-cta__title">{both ? copy.bothTitle : copy.title}</p>
    <p>{both ? copy.bothText : copy.text}</p>
  </div>
  <div class="guide-cta__actions">
    {
      both ? (
        <>
          <a class="guide-cta__button" href={`${base}playa-escondida/`}>
            {copy.special} <span aria-hidden="true">→</span>
          </a>
          <a class="guide-cta__button guide-cta__button--light" href={`${base}snorkel-islas-marietas/`}>
            {copy.classic} <span aria-hidden="true">→</span>
          </a>
        </>
      ) : (
        <a class="guide-cta__button" href={copy.toursHref}>
          {copy.tours} <span aria-hidden="true">→</span>
        </a>
      )
    }
    <a class="guide-cta__link" href={whatsappUrl()} target="_blank" rel="noreferrer"
      >{copy.whatsapp} <span aria-hidden="true">↗</span></a
    >
  </div>
</aside>

<style>
  .guide-cta {
    display: grid;
    gap: 1.25rem;
    margin: 3rem 0 0;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    background: var(--color-primary);
    color: white;
  }
  .guide-cta__title {
    margin: 0 0 0.4rem;
    font: 600 clamp(1.5rem, 3vw, 2rem)/1.1 var(--font-display);
  }
  .guide-cta p:not(.guide-cta__title) {
    margin: 0;
    color: #cfe2dc;
    line-height: 1.6;
  }
  .guide-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }
  .guide-cta__button {
    display: inline-flex;
    gap: 0.5rem;
    padding: 0.85rem 1.2rem;
    background: var(--color-accent);
    color: white;
    font-weight: 700;
  }
  .guide-cta__button--light {
    background: white;
    color: var(--color-primary);
  }
  .guide-cta__link {
    color: white;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
