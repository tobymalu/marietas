---
// Foto dentro del texto de una guía, a todo el ancho de la columna y sin
// efectos encima. Ruta "/imgMarietas/..." (vive en src/assets/imgMarietas/).
import Photo from "../Photo.astro";

interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="guide-figure not-prose">
  <Photo src={src} alt={alt} sizes="(max-width: 800px) 100vw, 760px" widths={[480, 760, 1140, 1520]} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .guide-figure {
    margin: 2.5rem 0;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 0.6rem;
    color: var(--color-muted);
    font-size: 0.82rem;
  }
</style>
