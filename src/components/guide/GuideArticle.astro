---
// Plantilla de una guía: encabezado, carrusel de fotos (sin overlays),
// cuerpo MDX y datos estructurados BlogPosting + BreadcrumbList.
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { absoluteImageUrl } from "../../lib/images";
import { faqSchema, organizationId } from "../../lib/schema";
import { site, type SiteLanguage } from "../../lib/site";
import PhotoCarousel from "../PhotoCarousel.astro";

interface Props {
  guide: CollectionEntry<"guias"> | CollectionEntry<"guiasEn">;
  lang?: SiteLanguage;
}

const { guide, lang = "es" } = Astro.props;
const { Content } = await render(guide);
const data = guide.data;
const en = lang === "en";
const locale = en ? "en-US" : "es-MX";
const formatDate = (date: Date) =>
  date.toLocaleDateString(locale, { timeZone: "UTC", dateStyle: "long" });

const copy = en
  ? { home: "Home", guides: "Guides", updated: "Updated", by: "By", breadcrumb: "Breadcrumb" }
  : { home: "Inicio", guides: "Guías", updated: "Actualizado", by: "Por", breadcrumb: "Ruta de navegación" };
const guidesHref = en ? "/en/blog/" : "/blog/";
const pageUrl = new URL(Astro.url.pathname, site.url).href;
const modified = data.updatedDate ?? data.pubDate;

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.h1,
    description: data.meta_description,
    inLanguage: en ? "en-US" : "es-MX",
    url: pageUrl,
    mainEntityOfPage: pageUrl,
    image: await absoluteImageUrl(data.featured_image.url),
    datePublished: data.pubDate.toISOString(),
    dateModified: modified.toISOString(),
    author: { "@type": "Organization", name: data.author, url: site.url },
    publisher: { "@id": organizationId },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { name: copy.home, item: new URL(en ? "/en/" : "/", site.url).href },
      { name: copy.guides, item: new URL(guidesHref, site.url).href },
      { name: data.title, item: pageUrl },
    ].map((crumb, index) => ({ "@type": "ListItem", position: index + 1, ...crumb })),
  },
  ...(data.faq.length > 0 ? [faqSchema(data.faq)] : []),
];
---

<Layout
  lang={lang}
  title={data.meta_title}
  description={data.meta_description}
  canonical={data.canonical}
  ogImage={data.featured_image.url}
  noindex={data.noindex}
  type="article"
  alternateUrl={data.alternate}
>
  {
    schemas.map((schema) => (
      <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))
  }

  <article class="guide sections">
    <header class="container guide__header">
      <nav aria-label={copy.breadcrumb}>
        <ol class="guide__breadcrumb">
          <li><a href={en ? "/en/" : "/"}>{copy.home}</a></li>
          <li><a href={guidesHref}>{copy.guides}</a></li>
          <li aria-current="page">{data.categoria}</li>
        </ol>
      </nav>
      <h1>{data.h1}</h1>
      <p class="guide__lede">{data.resumen}</p>
      <p class="guide__meta">
        {copy.by} {data.author} · {copy.updated}
        <time datetime={modified.toISOString()}>{formatDate(modified)}</time>
      </p>
    </header>

    <PhotoCarousel photos={data.carrusel} lang={lang} priority />

    <div class="container guide__body">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .guide__header {
    padding-block: clamp(3rem, 7vw, 5rem) clamp(2rem, 4vw, 3rem);
  }
  .guide__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
    color: var(--color-muted);
    font-size: 0.8rem;
  }
  .guide__breadcrumb li:not(:last-child)::after {
    content: "/";
    margin-left: 0.4rem;
    opacity: 0.6;
  }
  .guide__breadcrumb a:hover {
    color: var(--color-primary);
  }
  .guide__breadcrumb [aria-current] {
    color: var(--color-accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  h1 {
    max-width: 22ch;
    margin: 0 0 1.2rem;
    font: 600 clamp(2.2rem, 5vw, 4rem)/1.05 var(--font-display);
    letter-spacing: -0.02em;
  }
  .guide__lede {
    max-width: 62ch;
    margin: 0;
    color: var(--color-muted);
    font-size: 1.15rem;
    line-height: 1.7;
  }
  .guide__meta {
    margin: 1.25rem 0 0;
    color: var(--color-muted);
    font-size: 0.82rem;
  }

  /* Cuerpo del artículo (contenido MDX) */
  .guide__body {
    max-width: 760px;
    padding-block: clamp(2.5rem, 6vw, 4rem) 1rem;
    color: var(--color-foreground);
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .guide__body :global(h2) {
    margin: 3rem 0 1rem;
    font: 600 clamp(1.7rem, 3.5vw, 2.3rem)/1.15 var(--font-display);
    letter-spacing: -0.01em;
  }
  .guide__body :global(h3) {
    margin: 2rem 0 0.6rem;
    font: 600 1.3rem/1.2 var(--font-display);
  }
  .guide__body :global(p),
  .guide__body :global(li) {
    color: #2b4a4e;
  }
  .guide__body :global(ul),
  .guide__body :global(ol) {
    padding-left: 1.3rem;
  }
  .guide__body :global(li) {
    margin: 0.4rem 0;
  }
  .guide__body :global(li::marker) {
    color: var(--color-accent);
  }
  .guide__body :global(a:not(.not-prose a)) {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .guide__body :global(strong) {
    color: var(--color-foreground);
  }
  .guide__body :global(blockquote) {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--color-accent);
    background: #fbf3ea;
  }
  .guide__body :global(blockquote p) {
    margin: 0.4rem 0;
  }
</style>
