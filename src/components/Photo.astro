---
// <picture> optimizado (AVIF + WebP + JPG de respaldo) para todas las fotos.
// `priority` = imagen LCP de la página: carga inmediata y prioridad alta.
// El resto carga en diferido. Width/height salen de la propia imagen.
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { Picture } from "astro:assets";
import { asset, responsiveWidths } from "../lib/images";

interface Props extends Omit<HTMLAttributes<"img">, "src" | "width" | "height"> {
  /** Solo si la imagen se muestra a un tamaño fijo (p. ej. el logo). */
  width?: number;
  height?: number;
  src: string | ImageMetadata;
  alt: string;
  /** Ancho que ocupa la imagen en pantalla, p. ej. "(max-width: 720px) 100vw, 560px". */
  sizes: string;
  widths?: number[];
  priority?: boolean;
}

const { src, alt, sizes, widths, priority = false, width, height, ...attrs } = Astro.props;
const image = asset(src);
---

<Picture
  src={image}
  alt={alt}
  formats={["avif", "webp"]}
  widths={widths ?? responsiveWidths(image)}
  sizes={sizes}
  {...(width && height ? { width, height } : {})}
  quality={70}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : "auto"}
  decoding={priority ? "auto" : "async"}
  {...attrs}
/>
