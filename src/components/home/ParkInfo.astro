---
import { getParkInfo } from "../../lib/home-content";
import type { SiteLanguage } from "../../lib/site";
import Accordion from "./Accordion.astro";

interface Props {
  lang?: SiteLanguage;
}

const { lang = "es" } = Astro.props;
const copy =
  lang === "en"
    ? {
        eyebrow: "Official park guide",
        title: "What to know before visiting the Islas Marietas",
        text: "The Islas Marietas National Park is regulated by CONANP. These rules protect the reef and keep Hidden Beach a sanctuary.",
        facts: [
          { value: "Wed–Sun", label: "Hidden Beach access" },
          { value: "Daily cap", label: "CONANP carrying capacity" },
          { value: "Life jacket", label: "Required to swim" },
        ],
      }
    : {
        eyebrow: "Guía oficial del parque",
        title: "Lo que debes saber antes de visitar las Islas Marietas",
        text: "El Parque Nacional Islas Marietas está regulado por la CONANP. Estas reglas protegen el arrecife y hacen posible que la Playa Escondida siga siendo un santuario.",
        facts: [
          { value: "Mié–Dom", label: "Acceso a Playa del Amor" },
          { value: "Cupo diario", label: "Capacidad de carga CONANP" },
          { value: "Chaleco", label: "Obligatorio para nadar" },
        ],
      };
---

<section class="park" aria-labelledby="park-title">
  <div class="container park__grid">
    <div class="park__intro">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 class="section-title" id="park-title">{copy.title}</h2>
      <p>{copy.text}</p>
      <dl class="park__facts">
        {
          copy.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <Accordion items={getParkInfo(lang)} />
  </div>
</section>

<style>
  .park {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: #ebe4d6;
  }
  .park__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .park__intro > p:not(.eyebrow) {
    color: var(--color-muted);
    line-height: 1.7;
  }
  .park__facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin: 2rem 0 0;
    background: #d3ddd9;
    border: 1px solid #d3ddd9;
  }
  .park__facts div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.3rem;
    padding: 1rem;
    background: var(--color-background);
  }
  dt {
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.4;
  }
  dd {
    margin: 0;
    color: var(--color-primary);
    font: 600 1.25rem/1.1 var(--font-display);
  }
  @media (max-width: 860px) {
    .park__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .park__facts {
      grid-template-columns: 1fr;
    }
  }
</style>
