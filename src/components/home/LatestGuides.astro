---
// Últimas guías del blog en el home: enlaces internos para que Google
// descubra y rastree los artículos nuevos desde la página principal.
import { getGuides } from "../../lib/guides";
import type { SiteLanguage } from "../../lib/site";
import GuideCard from "../guide/GuideCard.astro";

interface Props {
  lang?: SiteLanguage;
  limit?: number;
}

const { lang = "es", limit = 3 } = Astro.props;
const guides = await getGuides(lang, limit);
const copy =
  lang === "en"
    ? {
        eyebrow: "Travel guides",
        title: "Plan your trip with our latest guides",
        all: "See all guides",
        href: "/en/blog/",
      }
    : {
        eyebrow: "Guías de viaje",
        title: "Planea tu visita con nuestras guías",
        all: "Ver todas las guías",
        href: "/blog/",
      };
---

{
  guides.length > 0 && (
    <section class="container section-space" aria-labelledby="guides-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{copy.eyebrow}</p>
          <h2 class="section-title" id="guides-title">
            {copy.title}
          </h2>
        </div>
        <a class="text-link" href={copy.href}>
          {copy.all} <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="latest-guides">
        {guides.map((guide) => (
          <GuideCard guide={guide} lang={lang} headingLevel={3} />
        ))}
      </div>
    </section>
  )
}

<style>
  .latest-guides {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
</style>
